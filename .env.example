# ===== KẾT NỐI =====
# (cũng nhận tên EULER_API_KEY như project village)
SIGN_API_KEY=euler_YzI1MTUyNzllNjdlYWViZjE4ODdiZjRkYmZjMDYyMGMwZGExZjQxMmUyZDc4MGIyYzlkYmM4             # (tuỳ chọn) key Euler Stream miễn phí tại eulerstream.com — nên có nếu kết nối hay bị lỗi/429
EXTENDED_GIFT_INFO=false   # true = lấy tên/giá quà từ TikTok, CẦN gói Business Euler Stream (gói free sẽ lỗi kết nối)
UNKNOWN_GIFT_COINS=1      # số xu tạm tính cho quà chưa có trong server/gifts.json
TIKTOK_USERNAME=daicauthichfishing          # tên kênh ĐANG LIVE (có hay không có @ đều được). BỎ TRỐNG = chỉ chạy Mock
PORT=3000
RETRY_MS=10000
# ===== LOG =====
LOG_LEVEL=info            # debug | info | warn | error  (debug = ghi cả từng bình luận)
LOG_TO_FILE=true          # ghi file logs/YYYY-MM-DD.log
LOG_KEEP_DAYS=7           # tự xoá log cũ hơn N ngày
CLIENT_DEBUG=false        # true = in log game ra console trình duyệt (F12)
# ===== GAMEPLAY =====
MAX_FISHERS=36            # số người câu tối đa cùng lúc
FRENZY_SECONDS=45         # thời lượng Bão Cá Vàng
FRENZY_COOLDOWN_SECONDS=90  # nghỉ giữa 2 lần bão (năng lượng không tích trong thời gian này)
BIG_GIFT_COINS=50         # quà > ngưỡng này = Thả Lưới Lớn
GIFT_KEEP_SECONDS=25      # giữ nhân vật tặng quà trên cầu cảng
CHAT_ENERGY=0.6           # năng lượng mỗi bình luận
LIKE_ENERGY=0.1           # năng lượng mỗi lượt tim
# ===== SPOTLIGHT (Camera Focus + Vinh Danh) =====
SPOTLIGHT_ENABLED=true
SPOTLIGHT_ZOOM=1.8
SPOTLIGHT_COOLDOWN=6      # nghỉ tối thiểu giữa 2 lần Spotlight (giây) — tránh camera zoom liên tục
QTE_SECONDS=12            # thời gian giằng co với Thủy Quái
QTE_START=35              # lực kéo ban đầu (%)
QTE_DECAY=3.5             # lực tụt mỗi giây do cá vùng vẫy
QTE_PUSH=7                # +% mỗi bình luận của khán giả (chủ cần: QTE_PUSH_OWNER, từ khoá KEO nhân 1.5)
QTE_PUSH_OWNER=12
QTE_LIKE=1                # +% mỗi lượt tim
FAKE_FOCUS_CHANCE=0.6     # xác suất đồ troll (bồn cầu vàng, vịt cao su) cũng được zoom hào hùng
EVENT_MIN_SECONDS=60      # sự kiện ngoại cảnh ngẫu nhiên (ca-nô / sét / mực) mỗi 60-90s
EVENT_MAX_SECONDS=90
INK_LIKES=60              # số tim để lau sạch mực
VIP_SECONDS=180           # thời gian ở du thuyền VIP (3 phút)
# ===== ÂM THANH =====
TTS_ENABLED=true
TTS_LANG=vi-VN
SFX_VOLUME=0.5
MUSIC_VOLUME=0.35
MUSIC_SHUFFLE=true        # true = phát ngẫu nhiên, false = theo thứ tự tên file
MUSIC_FADE_MS=1500        # thời gian fade khi đổi bài / vào Bão Cá Vàng
